# Deployment-specific settings for regenerate-passwd.sh.
#
# Copy next to the script on the broker host as `regenerate-passwd.env`, fill
# in the real values, and source it before running. The file is per-deployment,
# so it is NOT committed -- only this example is.
#
# Secrets are NOT set here. MQTT_AUTH_RELAY_SECRET, MQTT_PASSWORD and
# MQTT_VIEWER_PASSWORD live in the broker host's own env file and are read from
# there, so this file can stay readable.

# The Convex HTTP-actions origin (the *site* host, which serves httpActions --
# not the main deployment URL).
CONVEX_HTTP_URL=https://convex-site.example.com

# The broker container's name. The script's built-in default is the
# pre-migration `relay-mosquitto-1`; an orchestrator that generates its own
# names will differ, so set it explicitly rather than relying on the default.
BROKER_CONTAINER=mosquitto-container-name

# Host-side paths of the two credential files.
#
# These are usually FILE-level bind mounts into the container. The script
# writes them in place for that reason -- see the note beside the write. If a
# deployment bind-mounts the whole config DIRECTORY instead, a rename would be
# safe there, but writing in place is correct either way.
PASSWD_PATH=/path/to/mosquitto/passwd
ACL_PATH=/path/to/mosquitto/acl.conf

# Set to 1 once every agent reports the canonical bare-device-id username, to
# stop emitting the legacy `ados-<id>` rows.
DROP_LEGACY_USERNAMES=0
