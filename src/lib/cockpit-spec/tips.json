{
  "v": 1,
  "$description": "Contextual tips on the flight screen. One at a time, ground only, never over STOP, the left column or the flight-state chip.",
  "rules": {
    "max_visible": 1,
    "show_only_when": { "armed": false, "airborne": false, "flight_screen": true, "sheet_or_menu_open": false, "tour_visible": false },
    "first_delay_ms": 2500,
    "gap_between_ms": 4000,
    "auto_dismiss_ms": 9000,
    "dismiss_on": ["tap_tip", "tap_anchor", "any_controller_button", "arm"],
    "never_cover_zones": ["stop", "left_column", "flight_state_chip"],
    "kiosk": "show",
    "persist": "per_device",
    "reset_setting_key": "tips.reset"
  },
  "tips": [
    { "id": "status_pill", "anchor": "status_pill", "trigger": "flight_screen_first_open", "order": 1 },
    { "id": "flight_state_chip", "anchor": "flight_state_chip", "trigger": "flight_screen_first_open", "order": 2 },
    { "id": "layer_level", "anchor": "layer_button", "trigger": "flight_screen_first_open", "order": 3 },
    { "id": "stop", "anchor": "stop", "trigger": "flight_screen_first_open", "order": 4 },
    { "id": "skills_chip", "anchor": "skill_picker_chip", "trigger": "skills_available", "order": 5 },
    { "id": "fly_here", "anchor": "bottom_left_card", "trigger": "goto_offered", "order": 6 },
    { "id": "gimbal_pad", "anchor": "gimbal_pad", "trigger": "gimbal_available", "order": 7 },
    { "id": "card_switch", "anchor": "bottom_left_card", "trigger": "flight_screen_second_open", "order": 8 }
  ]
}
