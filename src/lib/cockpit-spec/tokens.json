{
  "v": 1,
  "$description": "Cockpit colours, #RRGGBB or #RRGGBBAA. Mirrored in the brand source as semantic.ar.*, semantic.layer.* and semantic.state.*. The chrome group is the flight-screen panel look (translucent blurred panels, hairline border, type scale, spacing); every surface reads it instead of hard-coding panel colours.",
  "ar": {
    "route": "#FF3EC8",
    "future": "#FFFFFFCC",
    "home": "#FFD400",
    "follow": "#22D3EE",
    "detour": "#F59E0B",
    "blocked": "#EF4444",
    "halo": "#00000099",
    "paused": "#909090"
  },
  "ar_geometry": {
    "halo_px": 2,
    "marker_base_px": 24,
    "marker_size_scale_px": 40,
    "fpv_px": 18,
    "edge_arrow_px": 20,
    "edge_inset_px": 16,
    "other_wp_dot_px": 6,
    "other_wp_opacity": 0.4,
    "leg_active_px": 6,
    "leg_active_fill_opacity": 0.35,
    "leg_active_center_px": 2,
    "leg_next_px": 2,
    "leg_future_px": 1.5,
    "leg_future_fade": [1.0, 0.3]
  },
  "layer": {
    "obstacle_near": "#EF444473",
    "obstacle_mid": "#F59E0B4D",
    "obstacle_near_max_m": 2,
    "obstacle_mid_max_m": 5,
    "depth_near": "#EF444473",
    "depth_mid": "#F59E0B4D",
    "surface_zone": "#00C853",
    "unavailable_chip": "#909090"
  },
  "state": {
    "ready": "#00C853",
    "not_ready": "#EF4444",
    "pilot": "#2979FF",
    "skill": "#22D3EE",
    "goto": "#2979FF",
    "swarm": "#2979FF",
    "mission": "#FF3EC8",
    "rth": "#F59E0B",
    "fc": "#909090",
    "tuning": "#F59E0B",
    "stale": "#909090",
    "avoiding": "#F59E0B",
    "blocked": "#EF4444"
  },
  "lightbar": {
    "disarmed": "#00C853",
    "armed_idle": "#FFFFFF",
    "pilot": "#2979FF",
    "skill": "#22D3EE",
    "mission": "#FF3EC8",
    "rth": "#F59E0B",
    "low_battery": "#EF4444",
    "failsafe": "#EF4444"
  },
  "controller": { "pressed": "#3A82FF", "conflict": "#EF4444", "deadzone_ring": "#FFFFFF66", "art_stroke": "#EDEDED", "art_fill": "#00000000" },
  "chrome": {
    "panel_bg": "#0B0D12EB",
    "panel_bg_no_blur": "#0B0D12F5",
    "panel_blur_px": 8,
    "panel_blur_note": "backdrop blur behind every flight-screen panel; Android uses RenderEffect on API 31 and later, and panel_bg_no_blur where blur is unavailable",
    "border": "#FFFFFF1A",
    "border_px": 1,
    "radius_px": 6,
    "radius_small_px": 4,
    "control_px": 36,
    "control_note": "visual height of every top-bar control on every surface; the hit area stays at least 48",
    "text": "#F5F7FA",
    "text_dim": "#FFFFFFA3",
    "severity_ok": "#00C853",
    "severity_warning": "#F59E0B",
    "severity_critical": "#EF4444",
    "severity_icon": { "critical": "✕", "warning": "⚠", "info": "ℹ" },
    "severity_icon_note": "the glyph beside each item in the status pill's alert list, in its severity colour; info is any item that is neither warning nor critical",
    "text_critical": "#FF8A80",
    "stop_bg": "#C81E1E",
    "stop_text": "#FFFFFF",
    "type": {
      "top_bar_px": 13,
      "top_bar_line_px": 15,
      "value_px": 16,
      "value_numerals": "tabular",
      "label_px": 11,
      "chip_px": 13,
      "chip_weight": 600
    },
    "icon_px": 18,
    "gap_px": 8,
    "pad_px": 10,
    "edge_inset_px": 8
  }
}
