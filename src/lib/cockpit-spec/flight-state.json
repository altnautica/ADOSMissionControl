{
  "v": 1,
  "$description": "Flight-state chip. Rules are evaluated in order on the pilot kind; the first match wins. {placeholders} are filled from the pilot kind and its mission object. color names resolve through tokens.json state.*.",
  "rules": [
    { "id": "link_stale", "match": { "pilot_stale": true }, "text": "Link", "color": "stale", "dim": true, "button": null },
    { "id": "launching", "match": { "sequence_running": true }, "text": "Taking off · {step}", "color": "pilot", "button": "abort" },
    { "id": "idle_ready", "match": { "owner": "idle", "ready": true }, "text": "Ready", "color": "ready", "button": null },
    { "id": "idle_not_ready", "match": { "owner": "idle", "ready": false }, "text": "Not ready · {first_block_msg}", "color": "not_ready", "button": "setup_link_when_setup_needed" },
    { "id": "pilot", "match": { "owner": "pilot" }, "text": "Pilot · {profile}", "color": "pilot", "button": null, "button_if": { "match": { "mission_state": "paused" }, "button": "resume" } },
    { "id": "skill", "match": { "owner": "skill" }, "text": "{skill_label} · {mode_detail}", "color": "skill", "button": null },
    { "id": "goto", "match": { "owner": "goto" }, "text": "Goto · {dist_m} m", "color": "goto", "button": null },
    { "id": "swarm", "match": { "owner": "swarm" }, "text": "Swarm", "color": "swarm", "button": null },
    { "id": "tuning", "match": { "owner": "tuning" }, "text": "Tuning · {setup_step}", "color": "tuning", "button": null },
    { "id": "mission_paused", "match": { "mission_state": "paused" }, "text": "Mission paused · WP {seq}/{total}", "color": "mission", "button": "resume" },
    { "id": "mission_active", "match": { "owner": "mission_fc", "mission_state": "active" }, "text": "Mission · WP {seq}/{total} · {eta}", "suffix_if_landing_seq": " · Landing", "color": "mission", "button": null },
    { "id": "mission_complete", "match": { "mission_state": "complete", "complete_age_lt_ms": 10000 }, "text": "Mission complete", "color": "mission", "button": null },
    { "id": "mission_fc", "match": { "owner": "mission_fc" }, "text": "Mission · WP {seq}/{total}", "color": "mission", "button": null },
    { "id": "vtol_transition", "match": { "vtol_transitioning": true }, "text": "Transition", "color": "rth", "button": null },
    { "id": "fc_rth", "match": { "owner": "fc_mode", "fc_mode_class": "rtl" }, "text": "RTH · {home_dist_m} m", "color": "rth", "button": null },
    { "id": "fc_land", "match": { "owner": "fc_mode", "fc_mode_class": "land" }, "text": "Landing", "color": "rth", "button": null },
    { "id": "fc_other_ados_standby", "match": { "owner": "fc_mode", "control_mode": "ados" }, "text": "FC · {fc_mode_name_upper} · ADOS standing by", "color": "fc", "button": "take_control" },
    { "id": "fc_other", "match": { "owner": "fc_mode" }, "text": "FC · {fc_mode_name_upper}", "color": "fc", "button": "take_control" }
  ],
  "fc_mode_classes": {
    "$description": "Numeric custom_mode per firmware family; plane covers QuadPlane Q modes (QRTL 21, QLAND 20); copter AUTO_RTL 27 returns. Copter BRAKE (17) holds position, so it is in neither class.",
    "rtl": { "copter": [6, 21, 27], "plane": [11, 21] },
    "land": { "copter": [9], "plane": [20] }
  },
  "secondary": {
    "order": ["fc_failsafe", "speed_cap", "mission_paused_line", "hold_reason", "avoid_state", "control_mode"],
    "fc_failsafe": { "text": "Failsafe", "color": "blocked" },
    "speed_cap": { "text": "GNSS-denied: {v} m/s max", "color": "avoiding", "text_key": "pilot.speed_cap.gnss_denied" },
    "mission_paused_line": { "match": { "owner": "pilot", "mission_state": "paused" }, "text": "Mission paused · WP {seq}/{total}", "color": "mission" },
    "avoid_state": {
      "detour": { "text": "Avoiding", "color": "avoiding" },
      "blocked": { "text": "Blocked", "color": "blocked" },
      "off": { "text": "Avoidance off", "color": "blocked" },
      "stale": { "text": "Obstacle data stale", "color": "avoiding" },
      "unavailable": { "text": "No obstacle sensor", "color": "avoiding" },
      "clear": null
    },
    "hold_reason": { "text": "{hold_reason_label}", "color": "avoiding" },
    "control_mode": {
      "ados": "ADOS Pilot",
      "fc_manual": "FC Manual",
      "elrs": "ELRS"
    }
  },
  "hold_reason_labels": {
    "blocked": "Blocked",
    "controller-lost": "Controller lost",
    "lease-busy": "Another skill has control",
    "lease-revoked": "Skill stopped",
    "link-loss": "Link lost",
    "no-vantage": "No clear view",
    "obstacle-close": "Obstacle close",
    "obstacle-data-stale": "Holding: no fresh obstacle data"
  },
  "hold_reason_labels_note": "keyed by the exact hold_reason wire string the pilot emits (hyphenated); setup-strings.json pilot.hold_reason.<same key> carries the same text",
  "stale_after_ms": 2000,
  "tap": "open_mode_sheet",
  "mode_sheet": {
    "sections": ["profile", "control_mode", "avoidance", "hand_to_fc", "fc_modes"],
    "profile": { "values": ["cine", "normal", "sport"], "labels": ["Cine", "Normal", "Sport"], "confirm": "tap" },
    "control_mode": {
      "values": ["ados", "fc_manual", "elrs"],
      "labels": ["ADOS Pilot", "FC Manual", "ELRS"],
      "explain": {
        "ados": "ADOS flies: your sticks go to ADOS Pilot, which holds position, avoids obstacles and runs skills.",
        "fc_manual": "The flight controller flies: your sticks go straight to the FC. ADOS still runs skills, gotos and missions.",
        "elrs": "The ground station's ELRS radio drives the FC's RC input. ADOS still runs skills, gotos and missions."
      },
      "elrs_only_on": "ground_station_link",
      "confirm": { "kind": "hold", "ms": 1500 }
    },
    "avoidance": {
      "values": ["brake", "bypass", "off"],
      "labels": ["Brake", "Bypass", "Off"],
      "confirm_off": { "kind": "hold", "ms": 1500 }
    },
    "hand_to_fc": {
      "values": ["loiter", "poshold", "althold"],
      "labels": ["Loiter", "PosHold", "AltHold"],
      "default": "loiter",
      "plane_values": ["loiter"]
    },
    "vtol_transition": { "shown_when": "vehicle_vtol", "to_fw_param1": 4, "to_mc_param1": 3 },
    "fc_modes": { "advanced": true, "mark_current": true, "sets_owner": "fc_mode" }
  }
}
