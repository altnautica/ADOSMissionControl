{
  "v": 1,
  "$description": "Video data layers. All layers draw into one canvas per video in ascending z; the HUD chrome sits above every layer. Flags and the level persist per surface and per vehicle. The centre stays a clean camera view: centre_marks draw at every level, the flight instruments only at the instruments level.",
  "layers": [
    { "id": "centre_marks", "label": "Centre marks", "default": true, "source": "telemetry", "lease": false, "z": 100, "kind": null, "groups": null, "parts": ["reticle", "heading_mark", "horizon_mark"] },
    { "id": "instruments", "label": "Instruments", "default": true, "source": "telemetry", "lease": false, "z": 101, "kind": null, "groups": null, "parts": ["pitch_ladder", "roll_arc", "flight_path_marker", "speed_tape", "altitude_tape", "vertical_speed_bar", "heading_tape"] },
    { "id": "depth", "label": "Depth", "default": false, "source": "depth", "lease": true, "z": 10, "kind": "depth", "groups": null },
    { "id": "surfaces", "label": "Surfaces", "default": false, "source": "surfaces", "lease": true, "z": 20, "kind": "surfaces", "groups": null },
    { "id": "obstacles", "label": "Obstacles", "default": true, "source": "obstacles", "lease": false, "z": 30, "kind": "obstacles", "groups": null },
    { "id": "targets", "label": "Targets", "default": true, "source": "vision detections", "lease": false, "z": 40, "kind": null, "groups": null },
    { "id": "ar_route", "label": "Route", "default": true, "source": "ar", "lease": false, "z": 50, "kind": "ar", "groups": ["wp", "leg", "home", "edge"] },
    { "id": "ar_motion", "label": "Motion", "default": true, "source": "ar", "lease": false, "z": 60, "kind": "ar", "groups": ["fpv", "fpath", "fgoal", "orbit"] }
  ],
  "plugin_layer": {
    "id_pattern": "plugin:<plugin_id>:<overlay_id>",
    "default": true,
    "source": "plugin overlay",
    "lease": false,
    "z": 70
  },
  "levels": {
    "order": ["instruments", "full", "route", "off"],
    "instruments": {
      "layers": "every layer whose default is true, plugin layers included",
      "ar_route_roles": { "wp": ["next", "after", "other"], "leg": ["active", "next", "future"] }
    },
    "full": {
      "layers": "every layer whose default is true, plugin layers included, except a layer listed in only_at_levels for other levels",
      "ar_route_roles": { "wp": ["next", "after", "other"], "leg": ["active", "next", "future"] }
    },
    "route": {
      "layers": ["centre_marks", "targets", "ar_route", "ar_motion", "obstacles"],
      "ar_route_roles": { "wp": ["next", "after"], "leg": ["active", "next"] },
      "always": ["home", "edge"]
    },
    "off": {
      "layers": ["centre_marks"]
    },
    "only_at_levels": { "instruments": ["instruments"] },
    "only_at_levels_note": "layer id -> the levels it draws at; such a layer draws only at those levels, and its flag still turns it off there",
    "lease_layers_independent": true,
    "note": "depth and surfaces are toggled on their own; the level never turns them on or off"
  },
  "level_controls": {
    "keyboard": "o",
    "gamepad": ["dpad_up", "dpad_down"],
    "top_bar_button": true,
    "cycle": "every control steps through levels.order and wraps, so all four levels are reachable"
  },
  "staleness": {
    "dim_after_ms": 500,
    "hide_after_ms": 2000,
    "unavailable_chip": "<layer> unavailable"
  },
  "view_lease": {
    "message": { "type": "view", "camera_id": "<served id>", "layers": ["ar_route", "ar_motion", "obstacles", "depth", "surfaces"] },
    "renew_ms": 2000,
    "expires_ms": 6000,
    "poll_query": "view=<camera_id>:<layer,...>",
    "release_when": ["document_hidden", "view_not_on_screen", "lifecycle_below_started"]
  },
  "vision_demand": {
    "route": "POST /api/vision/demand",
    "body": { "kind": "depth|surfaces", "camera_id": "<served id>", "hold_s": 6 },
    "renew_ms": 2000
  },
  "options": {
    "depth": {
      "style": { "values": ["solid", "outline"], "default": "solid" },
      "range_m": { "values": [null, 2, 5], "labels": ["Off", "2 m", "5 m"], "default": 5 }
    },
    "obstacles": {
      "near_max_m": 2,
      "mid_max_m": 5,
      "measured": "solid",
      "inferred": "outline",
      "unknown": "not drawn",
      "arc_strip": "bottom_center",
      "radar_card_source": "sectors_m"
    },
    "surfaces": {
      "stroke": "dashed",
      "score_chip": true
    }
  },
  "grid_decode": {
    "cols": 32,
    "rows": 18,
    "unknown_code": 0,
    "formula": "d = 0.2 * exp((v - 1) * ln(300) / 254)",
    "range_m": [0.2, 60],
    "measured_bit": 1
  },
  "persistence": {
    "scope": ["surface", "vehicle"],
    "keys": ["flags", "level"]
  },
  "interpolation": {
    "fade_in_ms": 120,
    "fade_out_ms": 120,
    "key_field": "k",
    "pip_draws_layers": false
  }
}
